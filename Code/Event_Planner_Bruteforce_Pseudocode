function Event_Planner_Bruteforce

    function valideset

        set_sum is sum of array

        if set_sum[time] is less than or equal to max_time and set_sum[money] is less than or equal to max_budget

            return True

        END if
        else:

        return False

        END else

    END function validset


    for l in range(1, number_of_events + 1)

        for subset in itertools.combinations(event_list, l)

            if validset(subset) is True

                event_combo_list is event_combo_list + subset

            END if

        END for

    END for


    for i in range(0, event_combo_list_length)

        info is sum(event_combo_list[i])

    END for

    subsets_with_details is subsets_with_details + [event_combo_list[i],info]

    best_combo_numeric is max of: subsets_with_details[enjoyment]

    return best_combo, details

END function Event_Planner_Bruteforce