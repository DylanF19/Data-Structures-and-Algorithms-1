# Event Planner Dynamic Pseudocode

function Event_Planner_Dynamic:
    data_field_3d = [[[0 for _ in range(max_budget + 1)] for _ in range(max_time + 1)] for _ in range(nunber of events + 1)]

    for i in range(n+1)
        
        for t in range(max_time+1)

            for m in range(max_budget+1)

                if i is 0 or t is 0 or m is 0

                    set data_field_3d[i][t][m] to 0
                END if
                else if event_list[i-1][1] is less than or equal to t and event_list[i-1][2] is less than or equal to m:

                    data_field_3d[i][t][m] = max of:
                        data_field_3d[i-1][t][m]
                            and
                        event_list[i-1][3] + data_field_3d[i-1][t-event_list[i-1][1]][m-event_list[i-1][2]]
                        
                END else if
                else:

                    set data_field_3d[i][t][m] to data_field_3d[i-1][t][m]

                END else

            END for

        END for 

    END for


    while x and y and z is greater than 0

        if data_field_3d[x][y][z] is not data_field_3d[x-1][y][z]

            solution is solution + [event_list[x-1]]
            j is j - event_list[x-1][1]
            k is k - event_list[x-1][2]

        END if

        decrement x by 1

    END while
    
    return best_combo, details

END function Event_Planner_Dynamic