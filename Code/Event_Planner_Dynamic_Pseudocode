# Event Planner Dynamic Pseudocode

function Event_Planner_Dynamic:
    data_field_2d = [[0 for _ in range(max_budget + 1)] for _ in range(number of events + 1)]

    for i in range(n+1)

        for m in range(max_budget+1)

            if i is 0 or m is 0

                set data_field_2d[i][m] to 0
            END if
            else if event_list[i-1][1] is less than or equal to m:

                data_field_2d[i][m] = max of(
                    data_field_2d[i-1][m]
                        and
                    event_list[i-1][2] + data_field_2d[i-1][m-event_list[i-1][1]]
                        )
            END else if
            else:

                set data_field_2d[i][m] to data_field_2d[i-1][m]

            END else


        END for 

    END for

    i is number_of_events
    j is max_budget

    while x and y is greater than 0

        if data_field_2d[x][y] is not data_field_2d[x-1][y]

            solution is solution + [event_list[x-1]]
            j is j - event_list[x-1][1]

        END if

        decrement x by 1

    END while
    
    return best_combo, details


END function Event_Planner_Dynamic


